@model WeatherViewModel

@{
    ViewData["Title"] = "Live Weather";
}

<style>
    body {
        background: linear-gradient(135deg, #141e30, #243b55);
        min-height: 100vh;
        font-family: 'Segoe UI', sans-serif;
    }

    .weather-container {
        max-width: 750px;
        margin: 50px auto;
    }

    .weather-title {
        color: white;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .weather-card {
        background: linear-gradient(145deg, #2193b0, #6dd5ed);
        border-radius: 25px;
        padding: 35px;
        color: white;
        box-shadow: 0 15px 40px rgba(0,0,0,.3);
        overflow: hidden;
    }

    .search-box {
        background: white;
        padding: 8px;
        border-radius: 50px;
        box-shadow: 0 5px 20px rgba(0,0,0,.15);
    }

        .search-box input {
            border: none;
            box-shadow: none !important;
            border-radius: 50px;
            padding-left: 20px;
        }

        .search-box button {
            border-radius: 50px;
            padding: 10px 25px;
            background: #172b4d;
            border: none;
        }

    .weather-icon {
        width: 120px;
        height: 120px;
        object-fit: contain;
        animation: float 3s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-12px);
        }
    }

    .temperature {
        font-size: 75px;
        font-weight: 700;
        line-height: 1.2;
    }

    .weather-condition {
        font-size: 22px;
        text-transform: capitalize;
    }

    .weather-info {
        background: rgba(255,255,255,.20);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 18px;
        padding: 20px 10px;
        height: 100%;
        backdrop-filter: blur(10px);
    }

        .weather-info h6 {
            opacity: .85;
            margin-top: 10px;
        }

        .weather-info h4 {
            font-weight: 700;
        }

    .weather-footer {
        font-size: 13px;
        opacity: .8;
    }

    .weather-heading {
        font-size: 14px;
        letter-spacing: 2px;
        text-transform: uppercase;
        opacity: .8;
    }

    @@media(max-width:576px) {
        .weather-container {
            margin: 25px 12px;
        }

        .weather-card {
            padding: 25px 18px;
        }

        .temperature {
            font-size: 60px;
        }
    }
</style>

<div class="container weather-container">

    <h2 class="text-center weather-title mb-2">
        <i class="bi bi-cloud-sun"></i>
        Live Weather
    </h2>

    <p class="text-center text-light mb-4">
        Check real-time weather conditions around the world
    </p>

    <!-- Search -->
    <form method="get" asp-action="Index" class="mb-4">

        <div class="input-group search-box">

            <input type="text"
                   name="city"
                   class="form-control"
                   placeholder="Enter city name..."
                   value="@(Model?.City ?? "Kochi")" />

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Search
            </button>

        </div>

    </form>

    <!-- Error -->
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <!-- Weather Details -->
    @if (Model != null)
    {
        <div class="weather-card text-center">

            <div class="weather-heading">
                Current Weather
            </div>

            <h2 class="mt-2 fw-bold">
                <i class="bi bi-geo-alt-fill"></i>
                @Model.City
            </h2>

            <img src="@Model.Icon"
                 alt="@Model.Condition"
                 class="weather-icon" />

            <div class="temperature">
                @Model.Temperature<sup style="font-size:30px">°C</sup>
            </div>

            <div class="weather-condition mb-4">
                @Model.Condition
            </div>

            <div class="row g-3">

                <!-- Humidity -->
                <div class="col-6">

                    <div class="weather-info">

                        <i class="bi bi-droplet-fill fs-2"></i>

                        <h6>Humidity</h6>

                        <h4>@Model.Humidity %</h4>

                    </div>

                </div>

                <!-- Wind -->
                <div class="col-6">

                    <div class="weather-info">

                        <i class="bi bi-wind fs-2"></i>

                        <h6>Wind Speed</h6>

                        <h4>@Model.WindSpeed km/h</h4>

                    </div>

                </div>

            </div>

            <hr class="border-light mt-4" />

            <div class="weather-footer">

                <i class="bi bi-clock"></i>
                Last Updated: @Model.LastUpdated

            </div>

        </div>
    }

    <p class="text-center text-light mt-4 small">
        Powered by Live Weather API
    </p>

</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<script>
    // Automatically refresh every 5 minutes
    setTimeout(function() {
        location.reload();
    }, 300000);
</script>

